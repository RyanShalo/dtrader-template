{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "npm run build:all",
    "outputDirectory": "packages/core/dist",
    "installCommand": "npm install --legacy-peer-deps",
    "framework": null,
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        { "source": "/(.*)", "destination": "/index.html" }
    ]
}
